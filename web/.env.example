# URL gốc của API (không có dấu / ở cuối)
# - Local:  http://localhost:5000
# - Render: https://taskflow-api.onrender.com
VITE_API_URL=http://localhost:5000

# (Không bắt buộc) Hiện nút "Dùng thử bằng tài khoản demo" ở trang đăng nhập.
# Phải khớp với tài khoản demo tạo bởi `npm run seed` trong api/. Xoá 2 dòng này nếu không muốn có nút demo.
VITE_DEMO_EMAIL=demo@taskflow.dev
VITE_DEMO_PASSWORD=Demo@123456

# (Không bắt buộc) Báo lỗi giao diện lên Sentry: DSN của project "React" trên sentry.io.
# Đăng nhập Google, tải ảnh Cloudinary không cần biến ở đây: web tự đọc cấu hình từ API (/api/config).
VITE_SENTRY_DSN=

# (Không bắt buộc) Địa chỉ trang quản trị (thư mục admin/). Tài khoản admin sẽ thấy nút mở trang này trong Cài đặt.
VITE_ADMIN_URL=
