# URL gốc của API (không có dấu / ở cuối)
# - Local:  http://localhost:5000
# - Render: https://taskflow-api.onrender.com
VITE_API_URL=http://localhost:5000

# (Không bắt buộc) Hiện nút "Dùng thử bằng tài khoản demo" ở trang đăng nhập.
# Phải khớp với tài khoản demo tạo bởi `npm run seed` trong api/. Xoá 2 dòng này nếu không muốn có nút demo.
VITE_DEMO_EMAIL=demo@taskflow.dev
VITE_DEMO_PASSWORD=Demo@123456
