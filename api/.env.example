# Cổng chạy server (Render tự set PORT, không cần khai báo khi deploy)
PORT=5000

# Chuỗi kết nối MongoDB
# - Local:  mongodb://127.0.0.1:27017/taskflow
# - Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Các origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Hỗ trợ dấu * cho preview của Vercel, ví dụ: https://taskflow-*.vercel.app
CORS_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development

# Khoá bí mật để ký JWT (token đăng nhập). BẮT BUỘC khi NODE_ENV=production, tối thiểu 32 ký tự.
# Tạo chuỗi ngẫu nhiên bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tuyệt đối không commit giá trị thật lên GitHub. Đổi khoá này = mọi người dùng bị đăng xuất.
JWT_SECRET=

# Thời hạn token đăng nhập (ví dụ 7d, 12h, 30d)
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Các tính năng thêm (không bắt buộc). Để trống thì tính năng đó tự ẩn, app vẫn chạy bình thường.
# Xem hướng dẫn lấy từng khoá trong DEPLOY.md, mục "Tính năng thêm".
# ---------------------------------------------------------------------------

# Địa chỉ trang web, dùng để tạo link trong email. Để trống thì lấy địa chỉ đầu tiên trong CORS_ORIGIN.
# Ví dụ: https://taskflow-abc.vercel.app
APP_URL=

# Gửi email (quên mật khẩu, lời mời vào dự án) qua Brevo HOẶC Resend. Chỉ cần một trong hai khoá.
# MAIL_FROM phải là email/tên miền đã xác minh bên nhà cung cấp, ví dụ: TaskFlow <ban@gmail.com>
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=

# Đăng nhập bằng Google: Client ID loại "Web application" tạo trong Google Cloud Console
GOOGLE_CLIENT_ID=

# Lưu ảnh (ảnh đính kèm, ảnh đại diện) trên Cloudinary. Cần "upload preset" chế độ Unsigned.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Báo lỗi tự động lên Sentry (DSN của project Node.js trên sentry.io)
SENTRY_DSN=
# Tỉ lệ request được đo hiệu năng (0 đến 1)
SENTRY_TRACES_SAMPLE_RATE=0.1
