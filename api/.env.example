# Cổng chạy server (Render tự set PORT, không cần khai báo khi deploy)
PORT=5000

# Chuỗi kết nối MongoDB
# - Local:  mongodb://127.0.0.1:27017/taskflow
# - Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Các origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Hỗ trợ dấu * cho preview của Vercel, ví dụ: https://taskflow-*.vercel.app
CORS_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development
